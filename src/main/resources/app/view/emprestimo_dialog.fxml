<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.controller.EmprestimoDialogController"
      styleClass="dialog-container"
      spacing="18"
      prefWidth="480">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <ImageView fitHeight="36" fitWidth="36" preserveRatio="true" styleClass="dialog-logo">
            <Image url="@../icons/logo.png"/>
        </ImageView>
        <Label fx:id="lblTitulo" text="Novo empréstimo" styleClass="view-title"/>
    </HBox>

    <HBox spacing="10">
        <ToggleButton fx:id="btnEmprestei"
                      text="Emprestei"
                      maxWidth="Infinity"
                      HBox.hgrow="ALWAYS"
                      styleClass="toggle-type, toggle-entrada"/>
        <ToggleButton fx:id="btnPedi"
                      text="Pedi emprestado"
                      maxWidth="Infinity"
                      HBox.hgrow="ALWAYS"
                      styleClass="toggle-type, toggle-saida"/>
    </HBox>

    <VBox spacing="6">
        <Label text="Nome" styleClass="form-label"/>
        <TextField fx:id="txtNome" promptText="Nome da pessoa ou descrição" styleClass="form-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Valor" styleClass="form-label"/>
        <TextField fx:id="txtValor" promptText="0,00" styleClass="form-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Data de pagamento" styleClass="form-label"/>
        <DatePicker fx:id="datePagamento"
                    promptText="Selecione a data"
                    prefHeight="40"
                    maxWidth="Infinity"
                    styleClass="form-combo"/>
    </VBox>

    <Label fx:id="lblErro"
           text=""
           visible="false"
           managed="false"
           styleClass="error-label"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnExcluir"
                text="Excluir"
                visible="false"
                managed="false"
                styleClass="button-excluir"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCancelar" text="Cancelar" styleClass="button-secondary"/>
        <Button fx:id="btnSalvar" text="Salvar" styleClass="button-primary"/>
    </HBox>
</VBox>
