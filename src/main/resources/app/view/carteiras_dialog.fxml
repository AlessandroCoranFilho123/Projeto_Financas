<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.controller.CarteirasDialogController"
      styleClass="dialog-container"
      spacing="18"
      prefWidth="480">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <ImageView fitHeight="36" fitWidth="36" preserveRatio="true" styleClass="dialog-logo">
            <Image url="@../icons/emprestimo.png"/>
        </ImageView>
        <Label text="Carteiras" styleClass="view-title"/>
    </HBox>

    <VBox spacing="6">
        <Label text="Banco" styleClass="form-label"/>
        <TextField fx:id="txtBanco" promptText="0,00" styleClass="form-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Dinheiro físico" styleClass="form-label"/>
        <TextField fx:id="txtDinheiroFisico" promptText="0,00" styleClass="form-field"/>
    </VBox>

    <Label fx:id="lblErro"
           text=""
           visible="false"
           managed="false"
           styleClass="error-label"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCancelar" text="Cancelar" styleClass="button-secondary"/>
        <Button fx:id="btnSalvar" text="Salvar" styleClass="button-primary"/>
    </HBox>
</VBox>
